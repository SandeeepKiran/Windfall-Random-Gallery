<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- API 30-32 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- API 33+ granular media -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- API 34+ partial / user-selected visual access -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
        No backup, on purpose: favourites, settings, folder names and the media index stay on
        this phone (README, "Permissions & privacy"). allowBackup=false stops cloud backup; on
        Android 12+ it does NOT stop device-to-device transfer, which dataExtractionRules does.
    -->
    <application
        android:name=".GalleryApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_windrose"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_windrose"
        android:supportsRtl="true"
        android:theme="@style/Theme.Windfall"
        android:enableOnBackInvokedCallback="true">

        <!--
            Handling rotation in-process keeps ExoPlayer alive across orientation changes so
            videos keep playing instead of restarting. Compose re-reads the new configuration
            on its own, so layouts still adapt.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Windfall"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true" />

        <!--
            Switchable launcher icons (Settings → Appearance → App icon). The LAUNCHER entry
            lives on aliases so the icon can change at runtime via setComponentEnabledSetting
            without touching MainActivity. Exactly one alias is enabled at a time; Windrose is
            the install default. All three share the same monochrome layer for themed icons.
        -->
        <activity-alias
            android:name=".IconWindrose"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_windrose"
            android:roundIcon="@mipmap/ic_launcher_windrose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconClassic"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_gemini"
            android:roundIcon="@mipmap/ic_launcher_gemini">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconMono"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_mono"
            android:roundIcon="@mipmap/ic_launcher_mono">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
