<?xml version="1.0" encoding="utf-8"?>
<!--
    Only these two folders can ever be handed to another app, and only one file at a time.
    Keep them narrow: path="." here used to expose the whole cache (Coil's image cache included).
-->
<paths>
    <cache-path name="exports" path="exports/" />
    <cache-path name="logs" path="logs/" />
</paths>
