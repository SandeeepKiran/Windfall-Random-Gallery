<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and older. allowBackup="false" already turns backup off there; this only makes
    the same "nothing leaves the phone" rule explicit (see data_extraction_rules.xml).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
