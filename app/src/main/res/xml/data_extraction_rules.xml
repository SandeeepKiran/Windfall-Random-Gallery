<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing leaves the phone, neither to cloud backup nor to a new device.
    Favourites are keyed to this phone's media ids, so on another phone they'd point at
    nothing anyway. Settings can still be moved deliberately with Export / Import.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
